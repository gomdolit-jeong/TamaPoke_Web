@using TamaPoke.Web.Game
@using TamaPoke.Web.Utils
@inject Loc Loc

@if (_isMoreOpen)
{
    <button type="button" class="menu-backdrop" aria-label="@Loc.T("common.close")" @onclick="() => _isMoreOpen = false"></button>
}
<nav class="pet-menu @(_isMoreOpen ? "is-more-open" : "")" aria-label="@Loc.T("web.menu")">
    <h2 class="pet-menu-title">@Loc.T("web.menu")</h2>
    <button type="button" class="menu-primary menu-battle" disabled="@(!Pet.CanStartActivity)" @onclick="() => Run(OnStartBattle)">@Label(Loc.T("web.menu.battle"))</button>
    <button type="button" disabled="@(!CanOpenPanels)" @onclick="() => Run(OnOpenGym)">@Label(Loc.T("web.menu.gym"))</button>
    <button type="button" class="menu-primary" disabled="@(!Pet.CanStartWalk)" @onclick="() => Run(OnStartWalk)">@Label(Loc.T("web.menu.walk"))</button>
    <button type="button" class="menu-primary" @onclick="() => Run(OnOpenDex)">@Label(Loc.T("web.menu.dex"))</button>
    <button type="button" disabled="@(!CanOpenProfile)" @onclick="() => Run(OnOpenProfile)">@Label(Loc.T("web.menu.profile"))</button>
    <button type="button" class="menu-primary" disabled="@(!CanOpenPanels)" @onclick="() => Run(OnOpenParty)">@Label(Loc.T("web.menu.party"))</button>
    <button type="button" disabled="@(!CanOpenPanels)" @onclick="() => Run(OnOpenBag)">@Label(Loc.T("web.menu.bag"))</button>
    <button type="button" class="menu-more" aria-expanded="@(_isMoreOpen ? "true" : "false")" @onclick="() => _isMoreOpen = !_isMoreOpen">
        @Label(_isMoreOpen ? "✕ " + Loc.T("common.close") : Loc.T("web.menu.more"))
    </button>

    @if (_confirmRelease)
    {
        <div class="pet-menu-confirm" role="alertdialog" aria-label="@Loc.T("release.confirm.title")">
            <p>@Loc.T("release.confirm.message")</p>
            <div class="pet-menu-row">
                <button type="button" @onclick="Release">@Loc.T("common.yes")</button>
                <button type="button" @onclick="() => _confirmRelease = false">@Loc.T("common.no")</button>
            </div>
        </div>
    }
    else
    {
        <button type="button" disabled="@(!CanRelease)" @onclick="() => _confirmRelease = true">@Label(Loc.T("web.menu.release"))</button>
    }

    <hr />

    <button type="button" disabled="@(!CanOpenPanels)" @onclick="() => Run(OnOpenSettings)">@Label(Loc.T("web.menu.settings"))</button>
    @Cloud

    <button type="button" aria-pressed="@(Pet.IsMuted ? "true" : "false")" @onclick="OnToggleMute">
        <img src="ui/@(Pet.IsMuted ? "icon_sound_off.png" : "icon_sound_on.png")" alt="" />
        <span>@Loc.T(Pet.IsMuted ? "web.sound.off" : "web.sound.on")</span>
    </button>
    <button type="button" lang="@(Loc.Language == Loc.Korean ? "en" : "ko")" @onclick="OnToggleLanguage">
        @Label("🌐 " + (Loc.Language == Loc.Korean ? "English" : "한국어"))
    </button>
</nav>

@code {
    // "🏅 체육관"을 아이콘과 글자로 나눕니다. 좁은 화면에서는 아이콘 아래에 글자가 옵니다.
    public static RenderFragment Label(string text) => __builder =>
    {
        int split = text.IndexOf(' ');
        <span class="menu-icon" aria-hidden="true">@text[..Math.Max(split, 0)]</span>
        <span class="menu-label">@text[(split + 1)..]</span>
    };

    [Parameter, EditorRequired] public required PokemonState Pet { get; set; }
    [Parameter] public RenderFragment? Cloud { get; set; }
    [Parameter] public EventCallback OnStartBattle { get; set; }
    [Parameter] public EventCallback OnOpenDex { get; set; }
    [Parameter] public EventCallback OnOpenProfile { get; set; }
    [Parameter] public EventCallback OnOpenParty { get; set; }
    [Parameter] public EventCallback OnOpenGym { get; set; }
    [Parameter] public EventCallback OnStartWalk { get; set; }
    [Parameter] public EventCallback OnOpenSettings { get; set; }
    [Parameter] public EventCallback OnOpenBag { get; set; }
    [Parameter] public EventCallback OnToggleMute { get; set; }
    [Parameter] public EventCallback OnToggleLanguage { get; set; }

    private bool _confirmRelease;
    private bool _isMoreOpen; // 휴대폰 탭 바의 더보기

    private Task Run(EventCallback action)
    {
        _isMoreOpen = false;
        return action.InvokeAsync();
    }

    private bool CanOpenProfile => Pet.CanStartActivity;
    private bool CanOpenPanels => !Pet.IsAnyMiniGameOpen && !Pet.IsBattleOpen && !Pet.IsCeremony;
    private bool CanRelease => Pet.CanStartActivity || (Pet.IsSleeping && !Pet.IsAnyMiniGameOpen);

    private void Release()
    {
        _isMoreOpen = false;
        _confirmRelease = false;
        Pet.StartRelease();
    }
}
