@using TamaPoke.Web.Game
@using TamaPoke.Web.Utils
@inject Loc Loc
@inject PokemonDex Dex
@inject CloudSave CloudSave
@inject ArenaService Arena

<section class="pet-panel pet-panel-scroll" aria-label="@Loc.T("web.arena.title")">
    <header class="pet-panel-header">
        <h2>@Loc.T("web.arena.title")</h2>
        <button type="button" class="pet-close" aria-label="@Loc.T("common.close")" title="@Loc.T("common.close")" @onclick="OnClose"></button>
    </header>

    <div class="arena-tabs" role="tablist">
        <button type="button" role="tab" aria-selected="@(_showRanking ? "false" : "true")" class="@(_showRanking ? "" : "is-active")" @onclick="() => _showRanking = false">@Loc.T("web.arena.tab.battle")</button>
        <button type="button" role="tab" aria-selected="@(_showRanking ? "true" : "false")" class="@(_showRanking ? "is-active" : "")" @onclick="() => _showRanking = true">@Loc.T("web.arena.tab.ranking")</button>
    </div>

    <p class="party-note">@SeasonText</p>

    @if (Pet.IsEgg)
    {
        <p class="arena-message">@Loc.T("web.arena.egg")</p>
    }
    else if (!CloudSave.IsSignedIn || !CloudSave.IsAccountReady)
    {
        <p class="arena-message">@Loc.T("web.arena.signIn")</p>
        @if (IsDebugBuild && !_showRanking)
        {
            <button type="button" class="arena-random" @onclick="ChallengeTestFoe">@Loc.T("web.arena.test")</button>
        }
    }
    else if (_isLoading)
    {
        <p class="arena-message" role="status">@Loc.T("web.arena.loading")</p>
    }
    else if (_board is null)
    {
        <p class="arena-message is-warning" role="alert">@Loc.T("web.arena.failed")</p>
        <button type="button" class="arena-random" @onclick="LoadAsync">@Loc.T("web.arena.retry")</button>
    }
    else if (_showRanking)
    {
        var board = _board;
        <ol class="arena-list">
            @for (int i = 0; i < board.Top.Count; i++)
            {
                @RankRow(board.Top[i], i + 1, board.Top[i].Uid == board.Me.Uid)
            }
        </ol>
        @if (board.MyRank is null)
        {
            <ol class="arena-list arena-list-me">
                @RankRow(board.Me, null, true)
            </ol>
        }
    }
    else
    {
        var board = _board;
        <p class="party-note">@Loc.T("web.arena.rules")</p>
        <div class="arena-me">
            <span>@string.Format(Loc.T("web.arena.me"), board.Me.Points, board.Me.Wins, board.Me.Losses)</span>
            <span class="arena-rank">@(board.MyRank is int rank ? string.Format(Loc.T("web.arena.rank"), rank) : Loc.T("web.arena.unranked"))</span>
        </div>

        <form class="arena-nick" @onsubmit="SaveNicknameAsync" @onsubmit:preventDefault>
            <label for="arena-nickname">@Loc.T("web.arena.nickname")</label>
            <input id="arena-nickname" type="text" inputmode="latin" autocomplete="off" spellcheck="false"
                   maxlength="@ArenaNames.MAX_LENGTH" pattern="[A-Za-z0-9]*" placeholder="@Loc.T("web.arena.nickname.placeholder")"
                   @bind="_nickname" @bind:event="oninput" disabled="@_isSavingNick" />
            <button type="submit" class="arena-fight" disabled="@(_isSavingNick || ArenaNames.Normalize(_nickname) == board.Me.Nickname)">@Loc.T("web.arena.nickname.save")</button>
        </form>
        @if (_nickMessage is not null)
        {
            <p class="arena-message @(_nickMessageIsError ? "is-warning" : "")" role="status">@_nickMessage</p>
        }
        else if (string.IsNullOrEmpty(board.Me.Nickname))
        {
            <p class="party-note">@Loc.T("web.arena.nickname.hint")</p>
        }

        <button type="button" class="arena-random" disabled="@(!CanChallenge || Opponents.Count == 0)" @onclick="ChallengeRandom">@Loc.T("web.arena.random")</button>

        @if (Opponents.Count == 0)
        {
            <p class="arena-message">@Loc.T("web.arena.empty")</p>
        }
        <ol class="arena-list">
            @foreach (var entry in Opponents)
            {
                <li class="arena-row">
                    @Sprite(entry)
                    <span class="party-info">
                        <span class="party-name">@ArenaNames.Display(entry)</span>
                        <span class="party-level">@PokemonText(entry) · @string.Format(Loc.T("web.arena.score"), entry.Points)</span>
                    </span>
                    <button type="button" class="arena-fight" disabled="@(!CanChallenge)" @onclick="() => Challenge(entry)">@Loc.T("web.arena.fight")</button>
                </li>
            }
        </ol>
    }
</section>

@code {
    [Parameter, EditorRequired] public required PokemonState Pet { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<(ArenaEntry Foe, ArenaEntry Me)> OnChallenge { get; set; }

    private ArenaBoard? _board;
    private bool _isLoading;
    private bool _showRanking;
    private string? _nickname;
    private bool _isSavingNick;
    private string? _nickMessage;
    private bool _nickMessageIsError;

    private bool CanChallenge => Pet.CanStartActivity && !Pet.IsEgg;
    private List<ArenaEntry> Opponents => _board?.Top.Where(e => e.Uid != _board.Me.Uid).ToList() ?? [];

    private string SeasonText
    {
        get
        {
            var (start, end) = ArenaRules.SeasonRange(DateTime.UtcNow);
            return string.Format(Loc.T("web.arena.season"), start.ToString("M/d"), end.ToString("M/d"));
        }
    }

    private string PokemonText(ArenaEntry entry) => $"{(entry.Shiny ? "✨" : "")}{Dex.GetName(entry.SpeciesId, Loc.Language)} Lv.{entry.Level}";

    private RenderFragment Sprite(ArenaEntry entry) =>
        @<span class="party-sprite"><AnimatedSprite SpritePath="@Dex.SpritePath(entry.SpeciesId, entry.Form)" FallbackPath="@($"{entry.SpeciesId:D4}")" Paused="true" Scale="1" Alt="" /></span>;

    // 순위표 한 줄: 순위(1~3위는 메달), 포켓몬, 닉네임, 점수, 전적
    private RenderFragment RankRow(ArenaEntry entry, int? place, bool isMe)
    {
        int games = entry.Wins + entry.Losses;
        string record = string.Format(Loc.T("web.arena.record"), entry.Wins, entry.Losses, games == 0 ? 0 : entry.Wins * 100 / games);
        string placeText = place switch { 1 => "🥇", 2 => "🥈", 3 => "🥉", int n => n.ToString(), null => "-" };
        return @<li class="arena-row @(isMe ? "is-me" : "")">
            <span class="arena-place">@placeText</span>
            @Sprite(entry)
            <span class="party-info">
                <span class="party-name">@ArenaNames.Display(entry) <small class="arena-tag">@entry.Tag</small></span>
                <span class="party-level">@PokemonText(entry)</span>
                <span class="party-level">@record</span>
            </span>
            <span class="arena-score">@string.Format(Loc.T("web.arena.score"), entry.Points)</span>
        </li>;
    }

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        if (Pet.IsEgg || !CloudSave.IsSignedIn || !CloudSave.IsAccountReady) return;
        _isLoading = true;
        StateHasChanged();
        _board = await Arena.LoadAsync(Pet);
        _nickname = _board?.Me.Nickname;
        _isLoading = false;
    }

    private async Task SaveNicknameAsync()
    {
        if (_board is null || _isSavingNick) return;
        string? nickname = ArenaNames.Normalize(_nickname);
        var problem = ArenaNames.Check(nickname);
        if (problem != NicknameProblem.None)
        {
            ShowNickMessage(string.Format(Loc.T(ArenaNames.ProblemKey(problem)), ArenaNames.MIN_LENGTH, ArenaNames.MAX_LENGTH), isError: true);
            return;
        }

        _isSavingNick = true;
        var updated = await Arena.ChangeNicknameAsync(_board, nickname!);
        _isSavingNick = false;
        if (updated is null)
        {
            ShowNickMessage(Loc.T("web.arena.nickname.failed"), isError: true);
            return;
        }

        _board = updated;
        _nickname = nickname;
        Pet.ArenaNickname = nickname;
        Pet.NeedsSave = true;
        ShowNickMessage(Loc.T("web.arena.nickname.saved"), isError: false);
    }

    private void ShowNickMessage(string message, bool isError)
    {
        _nickMessage = message;
        _nickMessageIsError = isError;
    }

    private Task Challenge(ArenaEntry foe) => _board is { } board ? OnChallenge.InvokeAsync((foe, board.Me)) : Task.CompletedTask;

    private Task ChallengeRandom() =>
        ArenaRules.PickRandomFoe(Opponents, ArenaRules.ArenaLevel(Pet.Level), Random.Shared) is { } foe ? Challenge(foe) : Task.CompletedTask;

#if DEBUG
    private static bool IsDebugBuild => true;

    // 로컬 테스트: 로그인 없이 내 레벨과 같은 피카츄와 대전합니다. (결과는 저장하지 않음)
    private Task ChallengeTestFoe()
    {
        var foe = new ArenaEntry { Uid = "test", Tag = "#TEST", Nickname = "TestTrainer", SpeciesId = 25, Level = ArenaRules.ArenaLevel(Pet.Level), Skills = [85, 98, 0, 0], Genes = [20, 20, 20, 20], Training = [50, 50, 50] };
        var me = ArenaRules.Snapshot(Pet, "#ME", null) with { Uid = "me" };
        return OnChallenge.InvokeAsync((foe, me));
    }
#else
    private static bool IsDebugBuild => false;

    private static Task ChallengeTestFoe() => Task.CompletedTask;
#endif
}
