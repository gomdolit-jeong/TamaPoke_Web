@using TamaPoke.Web.Game
@using TamaPoke.Web.Utils
@using TamaPoke.Web.Sprites
@inject Loc Loc
@inject PokemonDex Dex

<section class="pet-panel pet-panel-scroll" aria-label="@Loc.T("idle.menu.profile")">
    <header class="pet-panel-header">
        <h2>@Dex.GetName(Pet.SpeciesId, Loc.Language)</h2>
        <button type="button" class="pet-close" aria-label="@Loc.T("common.close")" title="@Loc.T("common.close")" @onclick="OnClose"></button>
    </header>

    @if (Pet.FormDescription.Length > 0)
    {
        <p class="party-note">@Pet.FormDescription</p>
    }

    <h3>@Loc.T("web.profile.info")</h3>
    <div class="profile-hero">
    <PortraitImage SpritePath="@Pet.SpritePath" FallbackPath="@($"{Pet.SpeciesId:D4}")" Emotion="@PortraitEmotion.For(Pet)" Size="80" />
    <dl class="pet-facts">
        <dt>@Loc.T("web.profile.gender")</dt>
        <dd>@(Pet.IsGenderless ? "-" : Pet.IsFemale ? "♀" : "♂")</dd>
        <dt><img class="pet-title-icon" src="ui/icon_streak.png" alt="" />@Loc.T("profile.streak")</dt>
        <dd>@string.Format(Loc.T("profile.streak.days"), Pet.Streak)</dd>
        <dt>@Loc.T("profile.bond")</dt>
        <dd>@Pet.Bond</dd>
        <dt>@Loc.T("profile.favoriteBerry")</dt>
        <dd>@(Pet.BerryKnown ? Loc.T(BerryKeys[Pet.FavoriteBerry]) : "???")</dd>
    </dl>
    </div>

    <h3><img class="pet-title-icon" src="ui/icon_sword.png" alt="" />@Loc.T("profile.stats")</h3>
    @if (Pet.Dex.Get(Pet.SpeciesId) is { } info)
    {
        var (type1, type2) = PokemonForms.GetTypes(Pet.Dex, info.Id, Pet.SpriteForm.Length > 0 ? $"p{info.Id:D4}_{Pet.SpriteForm}.bin" : null);
        <p class="party-types">
            <span class="battle-type battle-type-@type1.ToString().ToLowerInvariant()">@type1</span>
            @if (type2 != PokemonType.None)
            {
                <span class="battle-type battle-type-@type2.ToString().ToLowerInvariant()">@type2</span>
            }
        </p>
    }
    <dl class="pet-facts">
        <dt>@Loc.T("profile.stat.atk")</dt><dd>@Pet.TrAtk</dd>
        <dt>@Loc.T("profile.stat.def")</dt><dd>@Pet.TrDef</dd>
        <dt>@Loc.T("profile.stat.spe")</dt><dd>@Pet.TrSpeed</dd>
    </dl>

    <h3>@Loc.T("profile.moves")</h3>
    @* 기술을 누르면 아래에 위력, 명중, 효과를 펼쳐 보여 줍니다. 한 번 더 누르면 접힙니다. *@
    <ul class="profile-moves">
        @foreach (var skill in Pet.CurrentSkills)
        {
            bool open = _openSkillId == skill.Id;
            <li class="@(open ? "is-open" : "")">
                <button type="button" class="profile-move" aria-expanded="@(open ? "true" : "false")" @onclick="() => ToggleSkill(skill.Id)">
                    <span>@(open ? "▾" : "▸") @skill.Name</span>
                    <span class="battle-type battle-type-@skill.Type.ToString().ToLowerInvariant()">@skill.Type</span>
                </button>
                @if (open)
                {
                    <div class="skill-detail">
                        <dl>
                            <dt>@Loc.T("web.skill.category")</dt><dd>@SkillText.Category(skill)</dd>
                            <dt>@Loc.T("web.skill.power")</dt><dd>@SkillText.Power(skill)</dd>
                            <dt>@Loc.T("web.skill.accuracy")</dt><dd>@SkillText.Accuracy(skill)</dd>
                        </dl>
                        <ul>
                            @foreach (string line in SkillText.Effects(skill))
                            {
                                <li>@line</li>
                            }
                        </ul>
                    </div>
                }
            </li>
        }
    </ul>

    <h3><img class="pet-title-icon" src="ui/icon_growth.png" alt="" />@Loc.T("profile.growth")</h3>
    <label class="pet-growth">
        <span>@Loc.T("profile.nextLevel") (@Pet.LevelProgressMinutes / 60)</span>
        <progress max="60" value="@Pet.LevelProgressMinutes"></progress>
    </label>
    <dl class="pet-facts">
        <dt>@Loc.T("profile.evolution")</dt>
        <dd>@EvolveProgress</dd>
        <dt>@Loc.T("profile.mistakes")</dt>
        <dd>@string.Format(Loc.T("profile.mistakes.count"), Pet.CareMistakes)</dd>
        <dt>@Loc.T("profile.weight")</dt>
        <dd>@Pet.Weight</dd>
    </dl>

    <h3>@Loc.T("profile.medals") · @string.Format(Loc.T("profile.medals.count"), Pet.MedalCount)</h3>
    <ul class="pet-medals">
        @foreach (var (bit, key) in PokemonState.MedalList)
        {
            bool has = (Pet.Medals & bit) != 0;
            <li class="@(has ? "has" : "")">
                <img src="ui/icon_medal.png" alt="" />
                <span>@Loc.T(key)</span>
                <span class="visually-hidden">@(has ? Loc.T("web.medal.earned") : Loc.T("web.medal.locked"))</span>
            </li>
        }
    </ul>
</section>

@code {
    private static readonly string[] BerryKeys = ["berry.red", "berry.blue", "berry.green"];

    [Parameter, EditorRequired] public required PokemonState Pet { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private int? _openSkillId;

    private void ToggleSkill(int id) => _openSkillId = _openSkillId == id ? null : id;

    private string EvolveProgress
    {
        get
        {
            if (Pet.IsFinalEvolution) return Loc.T("evolve.progress.final");
            if (Dex.GetEvolution(Pet.SpeciesId) is not { } evolution) return Loc.T("evolve.progress.noInfo");

            int remaining = evolution.EvolveLevel + Pet.CareMistakes - Pet.Level;
            if (remaining > 0) return string.Format(Loc.T("evolve.progress.remaining"), remaining);
            return Loc.T(Pet.LowestStat >= 40 ? "evolve.progress.ready" : "evolve.progress.lowCondition");
        }
    }
}
