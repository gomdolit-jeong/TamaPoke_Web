@page "/"
@using System.Diagnostics
@using TamaPoke.Web.Components
@using TamaPoke.Web.Game
@using TamaPoke.Web.Sprites
@using TamaPoke.Web.Utils
@implements IDisposable
@inject SaveStore Store
@inject Loc Loc
@inject PokemonDex Dex

<PageTitle>TamaPoke</PageTitle>

@if (_pet is null)
{
    <p class="pet-loading">@Loc.T("web.loading")</p>
}
else
{
    <section class="pet-device">
        <header class="pet-header">
            <h1>@Name</h1>
            <button type="button" class="pet-lang" lang="@(Loc.Language == Loc.Korean ? "en" : "ko")" @onclick="ToggleLanguageAsync">
                @(Loc.Language == Loc.Korean ? "English" : "한국어")
            </button>
        </header>

        <p class="pet-mood" role="status">@MoodText</p>

        <div class="pet-stage" style="background-image:url('@BackgroundUrl')">
            <button type="button" class="pet-actor" aria-label="@(Loc.T(_pet.IsEgg ? "web.tap.egg" : "web.tap.pet"))"
                    style="transform:translate(@(_pet.PosX.ToString("F1"))px,@(_pet.PosY.ToString("F0"))px)" @onclick="Tap">
                <AnimatedSprite SpritePath="@_pet.SpritePath" Action="_pet.CurrentAction" Row="_pet.CurrentRow" Flipped="_pet.FlipX < 0" Alt="" />
            </button>

            @if (_pet.EatingFood is int food)
            {
                <img class="pet-fx pet-fx-food" src="ui/@FoodIcons[food]" alt="" />
            }
            @if (_pet.IsBathing)
            {
                <img class="pet-fx pet-fx-bubble" src="ui/fx_bubble.png" alt="" />
            }
            @if (_pet.IsPetting)
            {
                <img class="pet-fx pet-fx-heart" src="ui/icon_heart.png" alt="" />
            }
            @if (_pet.IsEvolvingFlash)
            {
                <div class="pet-flash"></div>
            }
            <div class="pet-poops">
                @for (int i = 0; i < _pet.Poops; i++)
                {
                    <img src="ui/fx_poop.png" alt="" />
                }
            </div>
        </div>

        @if (_pet.CanShowEvolvePrompt)
        {
            <div class="pet-prompt">
                <button type="button" class="pet-prompt-main" @onclick="() => _pet.StartEvolution()">@Loc.T("idle.evolve")</button>
                <button type="button" @onclick="() => _pet.PostponeEvolution()">@Loc.T("idle.later")</button>
            </div>
        }
        @if (_pet.CanShowFarewellPrompt)
        {
            <div class="pet-prompt">
                <button type="button" class="pet-prompt-main" @onclick="() => _pet.StartFarewell()">@Loc.T("idle.farewell")</button>
                <button type="button" @onclick="() => _pet.PostponeFarewell()">@Loc.T("idle.later")</button>
            </div>
        }

        <ul class="pet-stats">
            @StatBar("stat.fullness", _pet.Fullness)
            @StatBar("stat.joy", _pet.Joy)
            @StatBar("stat.energy", _pet.Energy)
            @StatBar("stat.hygiene", _pet.Hygiene)
        </ul>

        @if (_pet.IsFeedMenuOpen)
        {
            <div class="pet-food-menu">
                @for (int i = 0; i < FoodIcons.Length; i++)
                {
                    int foodType = i;
                    <button type="button" @onclick="() => Act(p => p.Feed(foodType))">
                        <img src="ui/@FoodIcons[i]" alt="" />
                        <span>@Loc.T(FoodKeys[i])</span>
                    </button>
                }
            </div>
        }

        <div class="pet-actions">
            <button type="button" disabled="@(!_pet.CanCare || _pet.IsSleeping)" aria-expanded="@(_pet.IsFeedMenuOpen ? "true" : "false")" @onclick="() => _pet.IsFeedMenuOpen = !_pet.IsFeedMenuOpen">
                <img src="ui/icon_feed.png" alt="" /><span>@Loc.T("web.btn.feed")</span>
            </button>
            <button type="button" disabled title="@Loc.T("web.comingSoon")">
                <img src="ui/icon_play.png" alt="" /><span>@Loc.T("web.btn.play")</span>
            </button>
            <button type="button" disabled="@(!_pet.CanCare)" @onclick="() => Act(p => p.ToggleSleep())">
                <img src="ui/icon_sleep.png" alt="" /><span>@Loc.T(_pet.IsSleeping ? "web.btn.wake" : "web.btn.sleep")</span>
            </button>
            <button type="button" disabled="@(!_pet.CanCare || _pet.IsSleeping)" @onclick="() => Act(p => p.Clean())">
                <img src="ui/icon_bath.png" alt="" /><span>@Loc.T("web.btn.bath")</span>
            </button>
        </div>

        @if (_pet.CanCare)
        {
            @if (_confirmRelease)
            {
                <div class="pet-release-confirm" role="alertdialog" aria-label="@Loc.T("release.confirm.title")">
                    <p>@Loc.T("release.confirm.message")</p>
                    <div class="pet-prompt">
                        <button type="button" @onclick="Release">@Loc.T("common.yes")</button>
                        <button type="button" @onclick="() => _confirmRelease = false">@Loc.T("common.no")</button>
                    </div>
                </div>
            }
            else
            {
                <button type="button" class="pet-release" @onclick="() => _confirmRelease = true">@Loc.T("idle.menu.release")</button>
            }
        }
    </section>
}

@code {
    private static readonly string[] FoodIcons = ["icon_berry_red.png", "icon_berry_blue.png", "icon_berry_green.png", "icon_candy.png"];
    private static readonly string[] FoodKeys = ["food.red", "food.blue", "food.green", "food.candy"];

    // 이보다 오래 멈췄으면 탭이 뒤로 간 게 아니라 컴퓨터나 브라우저가 멈춘 것으로 보고 시간을 흘리지 않습니다.
    // 브라우저는 뒤에 있는 탭의 타이머를 최대 1분까지 늦춥니다.
    private const double MAX_CATCH_UP_MS = 120_000;

    private readonly CancellationTokenSource _cts = new();
    private PokemonState? _pet;
    private object? _lastRendered;
    private bool _confirmRelease;

    private string Name => _pet!.IsEgg ? Loc.T("pokemon.egg") : $"{Dex.GetName(_pet.SpeciesId, Loc.Language)} Lv.{_pet.Level}";
    private string MoodText
    {
        get
        {
            if (!_pet!.IsEvolving) return Loc.T(_pet.MoodKey);
            string oldName = Dex.GetName(_pet.EvolvedFromSpeciesId, Loc.Language);
            if (_pet.HasEvolved) return string.Format(Loc.T("evolve.done"), oldName, Dex.GetName(_pet.SpeciesId, Loc.Language));
            return _pet.IsEvolvingFlash ? string.Format(Loc.T("evolve.happening"), oldName) : Loc.T("evolve.what");
        }
    }

    private string BackgroundUrl => $"backgrounds/{Dex.GetBiomeName(_pet!.SpeciesId)}{(_pet.IsNight ? " NIGHT" : "")}.png";

    private RenderFragment StatBar(string key, int value) => @<li>
        <span class="pet-stat-name">@Loc.T(key)</span>
        <progress max="100" value="@value" aria-label="@Loc.T(key)"></progress>
        <span class="pet-stat-value">@value</span>
    </li>;

    protected override async Task OnInitializedAsync()
    {
        var pet = await Store.LoadAsync();
        pet.Dex = Dex;
        _pet = pet;
        _ = RunLoopAsync();
    }

    private void Act(Action<PokemonState> action) => action(_pet!);

    private void Tap() => _pet!.Tap();

    private void Release()
    {
        _confirmRelease = false;
        _pet!.StartRelease();
    }

    private Task ToggleLanguageAsync() => Loc.ToggleLanguageAsync();

    private async Task RunLoopAsync()
    {
        using var timer = new PeriodicTimer(TimeSpan.FromMilliseconds(33));
        long last = Stopwatch.GetTimestamp();
        try
        {
            while (await timer.WaitForNextTickAsync(_cts.Token))
            {
                long now = Stopwatch.GetTimestamp();
                double elapsedMs = Stopwatch.GetElapsedTime(last, now).TotalMilliseconds;
                last = now;
                if (elapsedMs > MAX_CATCH_UP_MS) continue;

                _pet!.Update(elapsedMs);

                if (_pet.NeedsSave)
                {
                    _pet.NeedsSave = false;
                    await Store.SaveAsync(_pet);
                }

                // 값이 바뀌었을 때만 다시 그립니다.
                object rendered = (_pet.PosX, _pet.FlipX, _pet.CurrentAction, _pet.MoodKey, _pet.IsPetting, _pet.IsNight,
                    (_pet.Fullness, _pet.Joy, _pet.Energy, _pet.Hygiene, _pet.Poops, _pet.Level, _pet.SpeciesId),
                    (_pet.IsEvolvingFlash, _pet.HasEvolved, _pet.CanShowEvolvePrompt, _pet.CanShowFarewellPrompt, _pet.IsSleeping));
                if (!rendered.Equals(_lastRendered))
                {
                    _lastRendered = rendered;
                    StateHasChanged();
                }
            }
        }
        catch (OperationCanceledException) { }
    }

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
    }
}
