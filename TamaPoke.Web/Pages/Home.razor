@page "/"
@using System.Diagnostics
@using TamaPoke.Web.Components
@using TamaPoke.Web.Game
@using TamaPoke.Web.Sprites
@using TamaPoke.Web.Utils
@implements IDisposable
@inject SaveStore Store
@inject Loc Loc
@inject PokemonDex Dex
@inject SoundPlayer Sound
@inject CloudSave CloudSave
@inject ArenaService Arena
@inject NavigationManager Navigation
@inject SkillDex Skills
@inject MegaDex Megas
@inject IJSRuntime JS

<PageTitle>TamaPoke</PageTitle>

@if (_pet is null)
{
    <p class="pet-loading">@Loc.T("web.loading")</p>
}
else if (_isOtherTabActive)
{
    <div class="pet-tab-guard" role="alert">
        <p>@Loc.T("web.otherTab")</p>
        <button type="button" @onclick="ReloadThisTab">@Loc.T("web.otherTab.reload")</button>
    </div>
}
else if (_pet.IsWalking)
{
    <WalkLayer Pet="_pet" OnEnd="() => _pet.EndWalk()" />
}
else if (ShowTitle)
{
    <TitleScreen CanSignIn="CloudSave.Status != CloudStatus.Unavailable"
                 IsSignInReady="CloudSave.Status is not (CloudStatus.Loading or CloudStatus.Syncing)"
                 HasSave="!_pet.HasNoProgress"
                 Note="@TitleNote"
                 OnSignIn="CloudSave.SignInAsync"
                 OnGuest="StartAsGuest"
                 OnToggleLanguage="ToggleLanguageAsync" />
}
else
{
    <div class="pet-layout">
    <section class="pet-device">
        <header class="pet-header">
            <img class="pet-header-ball" src="ui/icon_ball.png" alt="" />
            <h1>@Name</h1>
            @if (!_pet.IsEgg)
            {
                <span class="pet-level">Lv.@_pet.Level</span>
            }
        </header>

        <p class="pet-mood" role="status">@MoodText</p>

        @if (CloudSave.IsGuestImportPending)
        {
            <section class="pet-panel cloud-conflict" role="dialog" aria-label="@Loc.T("web.cloud.import.title")">
                <h2>@Loc.T("web.cloud.import.title")</h2>
                <p>@Loc.T("web.cloud.import.message")</p>
                <div class="pet-prompt">
                    <button type="button" class="pet-prompt-main" @onclick="CloudSave.ChooseGuestSaveAsync">@Loc.T("web.cloud.import.guest")<br />@Summary(_pet)</button>
                    <button type="button" class="pet-prompt-main" @onclick="CloudSave.ChooseNewEggAsync">@Loc.T("web.cloud.import.new")</button>
                </div>
            </section>
        }
        else if (CloudSave.Conflict is { } conflict)
        {
            <section class="pet-panel cloud-conflict" role="dialog" aria-label="@Loc.T("web.cloud.conflict.title")">
                <h2>@Loc.T("web.cloud.conflict.title")</h2>
                <p>@Loc.T("web.cloud.conflict.message")</p>
                <div class="pet-prompt">
                    <button type="button" class="pet-prompt-main" @onclick="CloudSave.ChooseCloudAsync">@Loc.T("web.cloud.useCloud")<br />@Summary(conflict.Remote)</button>
                    <button type="button" class="pet-prompt-main" @onclick="CloudSave.ChooseThisDeviceAsync">@Loc.T("web.cloud.useLocal")<br />@Summary(_pet)</button>
                </div>
            </section>
        }
        else if (_pet.IsBattleOpen)
        {
            <BattleStage Pet="_pet" Dex="Dex" />
        }
        else if (_pet.IsProfileOpen)
        {
            <ProfilePanel Pet="_pet" OnClose="CloseProfile" />
        }
        else if (_isDexOpen)
        {
            <DexPanel Pet="_pet" OnClose="() => _isDexOpen = false" />
        }
        else if (_isPartyOpen || _pet.IsSwapMode)
        {
            <PartyPanel Pet="_pet" OnClose="() => _isPartyOpen = false" />
        }
        else if (_isBagOpen)
        {
            <BagPanel Pet="_pet" OnClose="() => _isBagOpen = false" />
        }
        else if (_isGymOpen)
        {
            <GymPanel Pet="_pet" OnClose="() => _isGymOpen = false" OnChallenge="StartGym" />
        }
        else if (_isArenaOpen)
        {
            <ArenaPanel Pet="_pet" OnClose="() => _isArenaOpen = false" OnChallenge="StartArena" />
        }
        else if (_isSettingsOpen)
        {
            <SettingsPanel Pet="_pet" OnClose="() => _isSettingsOpen = false" ReplaceSave="ReloadWithSaveAsync" />
        }
        else if (_pet.ShownGame != MiniGame.None)
        {
            <MiniGameStage Pet="_pet" />
        }
        else
        {
        <div class="pet-stage" style="background-image:url('@BackgroundUrl')">
            <button type="button" class="pet-actor" aria-label="@(Loc.T(_pet.IsEgg ? "web.tap.egg" : "web.tap.pet"))"
                    style="transform:translate(@(_pet.PosX.ToString("F1"))px,@(_pet.PosY.ToString("F0"))px)" @onclick="Tap">
                <AnimatedSprite SpritePath="@_pet.SpritePath" FallbackPath="@(_pet.IsEgg ? null : $"{_pet.SpeciesId:D4}")" Action="_pet.CurrentAction" ContinuousState="true" Row="_pet.CurrentRow" Flipped="_pet.FlipX < 0" Scale="@(_pet.IsEgg ? 3 : 2)" Alt="" />
            </button>

            @if (_pet.EatingFood is int food)
            {
                <img class="pet-fx pet-fx-food" src="ui/@FoodIcons[food]" alt=""
                     style="clip-path:inset(0 @(_pet.FoodBites * 100 / 3)% 0 0);opacity:@(_pet.FoodOpacity.ToString("F2"))" />
            }
            @if (_pet.IsBathing)
            {
                <img class="pet-fx pet-fx-bubble pet-fx-bubble-1" src="ui/fx_bubble.png" alt="" />
                <img class="pet-fx pet-fx-bubble pet-fx-bubble-2" src="ui/fx_bubble.png" alt="" />
                <img class="pet-fx pet-fx-bubble pet-fx-bubble-3" src="ui/fx_bubble.png" alt="" />
            }
            @if (_pet.IsPetting)
            {
                <img class="pet-fx pet-fx-heart" @key="_pet.PetSerial" src="ui/icon_heart.png" alt="" />
            }
            @if (_pet.IsSleeping)
            {
                <img class="pet-fx pet-fx-zzz" src="ui/fx_zzz.png" alt="" />
            }
            <div class="pet-poops">
                @for (int i = 0; i < _pet.Poops; i++)
                {
                    <img src="ui/fx_poop.png" alt="" />
                }
            </div>

            @if (!_pet.IsPlayMenuOpen && !_pet.IsFeedMenuOpen)
            {
            <ul class="pet-stats">
                @StatBar("stat.fullness", "fullness", _pet.Fullness)
                @StatBar("stat.joy", "joy", _pet.Joy)
                @StatBar("stat.energy", "energy", _pet.Energy)
                @StatBar("stat.hygiene", "hygiene", _pet.Hygiene)
            </ul>
            }

            @if (_pet.IsPlayMenuOpen)
            {
                <div class="pet-food-menu">
                    @foreach (var game in Games)
                    {
                        <button type="button" title="@Loc.T(game.Label)" aria-label="@Loc.T(game.Label)" @onclick="() => _pet.StartMiniGame(game.Game)">
                            <img src="ui/@game.Icon" alt="" />
                        </button>
                    }
                </div>
            }

            @if (_pet.IsFeedMenuOpen)
            {
                <div class="pet-food-menu">
                    @for (int i = 0; i < FoodIcons.Length; i++)
                    {
                        int foodType = i;
                        <button type="button" title="@Loc.T(FoodKeys[i])" aria-label="@Loc.T(FoodKeys[i])" @onclick="() => Act(p => p.Feed(foodType))">
                            <img src="ui/@FoodIcons[i]" alt="" />
                        </button>
                    }
                </div>
            }
        </div>

        @if (_pet.CanShowEvolvePrompt)
        {
            <div class="pet-prompt">
                <button type="button" class="pet-prompt-main" @onclick="() => _pet.StartEvolution()">@Loc.T("idle.evolve")</button>
                <button type="button" @onclick="() => _pet.PostponeEvolution()">@Loc.T("idle.later")</button>
            </div>
        }
        @if (_pet.CanShowFarewellPrompt)
        {
            <div class="pet-prompt">
                <button type="button" class="pet-prompt-main" @onclick="() => _pet.StartFarewell()">@Loc.T("idle.farewell")</button>
                <button type="button" @onclick="() => _pet.PostponeFarewell()">@Loc.T("idle.later")</button>
            </div>
        }

        <div class="pet-actions">
            <button type="button" class="care-feed" disabled="@(!_pet.CanStartActivity)" aria-expanded="@(_pet.IsFeedMenuOpen ? "true" : "false")" @onclick="ToggleFeedMenu">
                <img src="ui/icon_feed.png" alt="" /><span>@Loc.T("web.btn.feed")</span>
            </button>
            <button type="button" class="care-play" disabled="@(!_pet.CanStartActivity)" aria-expanded="@(_pet.IsPlayMenuOpen ? "true" : "false")" @onclick="TogglePlayMenu">
                <img src="ui/icon_play.png" alt="" /><span>@Loc.T("web.btn.play")</span>
            </button>
            <button type="button" class="care-sleep" disabled="@(!_pet.CanCare)" @onclick="ToggleSleep">
                <img src="ui/icon_sleep.png" alt="" /><span>@Loc.T(_pet.IsSleeping ? "web.btn.wake" : "web.btn.sleep")</span>
            </button>
            <button type="button" class="care-bath" disabled="@(!_pet.CanStartActivity)" @onclick="Bath">
                <img src="ui/icon_bath.png" alt="" /><span>@Loc.T("web.btn.bath")</span>
            </button>
        </div>

        }

        @* 작별, 놔주기, 가출, 진화: 게임기 전체를 어둡게 하고 포켓몬과 메시지만 보여 줍니다. (PC판과 같음) *@
        @if (_pet.IsCeremony)
        {
            <div class="pet-ceremony">
                <div class="pet-ceremony-actor" style="transform:translate(@(_pet.PosX.ToString("F1"))px,@(_pet.PosY.ToString("F0"))px)">
                    <AnimatedSprite SpritePath="@_pet.SpritePath" FallbackPath="@($"{_pet.SpeciesId:D4}")" Action="_pet.CurrentAction" Row="_pet.CurrentRow" Flipped="_pet.FlipX < 0" FitBox="CeremonySpriteSize" NoPreload="true" Alt="" />
                    @if (_pet.IsEvolvingFlash)
                    {
                        <div class="pet-ceremony-flash">
                            <AnimatedSprite SpritePath="@_pet.SpritePath" FallbackPath="@($"{_pet.SpeciesId:D4}")" Action="_pet.CurrentAction" Row="_pet.CurrentRow" Flipped="_pet.FlipX < 0" FitBox="CeremonySpriteSize" NoPreload="true" Alt="" />
                        </div>
                    }
                </div>
                <p class="pet-ceremony-text">@MoodText</p>
            </div>
        }
    </section>

    <PetMenu Pet="_pet" OnOpenDex="OpenDex" OnOpenProfile="OpenProfile" OnOpenParty="OpenParty" OnOpenGym="OpenGym" OnOpenArena="OpenArena" OnStartWalk="StartWalk" OnOpenSettings="OpenSettings" OnOpenBag="OpenBag" OnStartBattle="StartBattle" OnToggleMute="ToggleMute" OnToggleLanguage="ToggleLanguageAsync">
        <Cloud>
            @if (CloudSave.IsSignedIn)
            {
                <button type="button" @onclick="CloudSave.SaveNowAsync">@PetMenu.Label("☁️ " + Loc.T("web.cloud.saveNow"))</button>
                <button type="button" @onclick="CloudSave.SignOutAsync">@PetMenu.Label("🚪 " + Loc.T("web.cloud.signOut"))</button>
            }
            else if (CloudSave.Status != CloudStatus.Unavailable)
            {
                <button type="button" disabled="@(CloudSave.Status == CloudStatus.Loading)" @onclick="CloudSave.SignInAsync"><img class="google-icon" src="ui/icon_google.svg" alt="" /><span class="menu-label">@Loc.T("web.cloud.signIn")</span></button>
            }
            <p class="cloud-status" role="status">@CloudStatusText</p>
        </Cloud>
    </PetMenu>
    </div>
}

@code {
    private static readonly string[] FoodIcons = ["icon_berry_red.png", "icon_berry_blue.png", "icon_berry_green.png", "icon_candy.png"];
    private static readonly string[] FoodKeys = ["food.red", "food.blue", "food.green", "food.candy"];
    private static readonly (MiniGame Game, string Icon, string Label)[] Games =
    [
        (MiniGame.Ball, "icon_ball.png", "game.ball"),
        (MiniGame.Catch, "icon_catch.png", "game.catch"),
        (MiniGame.Memo, "icon_memo.png", "game.memo"),
        (MiniGame.Clean, "icon_clean.png", "game.clean"),
    ];

    // 이보다 오래 멈췄으면 탭이 뒤로 간 게 아니라 컴퓨터나 브라우저가 멈춘 것으로 보고 시간을 흘리지 않습니다.
    // 브라우저는 뒤에 있는 탭의 타이머를 최대 1분까지 늦춥니다.
    private const double MAX_CATCH_UP_MS = 120_000;

    private readonly CancellationTokenSource _cts = new();
    private PokemonState? _pet;
    private object? _lastRendered;
    private bool _isDexOpen;
    private bool _isGuest;
    private bool _isPartyOpen;
    private bool _isBagOpen;
    private bool _isGymOpen;
    private bool _isArenaOpen;
    private bool _isOtherTabActive;
    private const double CeremonySpriteSize = 110;
    private DotNetObjectReference<Home>? _pageRef;
    private bool _isSettingsOpen;

    // 로그인하지 않았고 게스트도 고르지 않았으면 시작 화면을 보여줍니다. (이때는 시간이 흐르지 않습니다)
    private bool ShowTitle => CloudSave.IsSyncing || (!_isGuest && !CloudSave.IsAccountReady && !CloudSave.IsWaitingForChoice);

    private string TitleNote => CloudSave.SignInError is not null
        ? Loc.T("web.cloud.signInFailed")
        : CloudSave.IsSyncing ? Loc.T("web.cloud.loading")
        : CloudSave.IsSignedIn && CloudSave.Status == CloudStatus.Failed ? Loc.T("web.cloud.loadFailed")
        : CloudSave.Status == CloudStatus.Unavailable ? Loc.T("web.cloud.unavailable") : Loc.T("web.guest.note");

    private string Name => _pet!.IsEgg ? Loc.T("pokemon.egg") : (_pet.IsShiny ? "✨" : "") + Dex.GetName(_pet.SpeciesId, Loc.Language);
    private string MoodText
    {
        get
        {
            if (_pet!.EventMessage is { } message) return message;
            if (!_pet.IsEvolving) return Loc.T(_pet.MoodKey);
            string oldName = Dex.GetName(_pet.EvolvedFromSpeciesId, Loc.Language);
            if (_pet.HasEvolved) return string.Format(Loc.T("evolve.done"), oldName, Dex.GetName(_pet.SpeciesId, Loc.Language));
            return _pet.IsEvolvingFlash ? string.Format(Loc.T("evolve.happening"), oldName) : Loc.T("evolve.what");
        }
    }

    private string BackgroundUrl => $"backgrounds/{Dex.GetBiomeName(_pet!.SpeciesId, _pet.SpriteForm)}{(_pet.IsNight ? " NIGHT" : "")}.png";

    private RenderFragment StatBar(string key, string kind, int value) => @<li class="pet-stat-@kind">
        <span class="pet-stat-name">@Loc.T(key)</span>
        <progress max="100" value="@value" aria-label="@Loc.T(key)"></progress>
        <span class="pet-stat-value">@value</span>
    </li>;

    protected override async Task OnInitializedAsync()
    {
        var saved = await Store.LoadAsync();
#if DEBUG
        // 로컬 테스트: 세이브가 비어 있으면 강한 파티로 시작합니다.
        if (saved.HasNoProgress) saved = TestSave.Create(Megas);
#endif
        _pet = PreparePet(saved);
        CloudSave.Changed += OnCloudChanged;
        _ = CloudSave.InitializeAsync(() => _pet!, SwitchSaveAsync);
        _ = RunLoopAsync();

        _pageRef = DotNetObjectReference.Create(this);
        await JS.InvokeVoidAsync("tamaPoke.claimTab", _pageRef);
    }

    private PokemonState PreparePet(PokemonState pet)
    {
        pet.Dex = Dex;
        pet.PlaySound = PlaySound;
        pet.SkillBook = Skills;
        pet.Megas = Megas;
        pet.SendNotification = (title, body) => _ = JS.InvokeVoidAsync("tamaPoke.notify", title, body);
        pet.ArenaResultReady = entry => _ = SaveArenaResultAsync(entry);
        ShowLoadNotice(pet);
        pet.RegisterCurrentInDex();
        if (!pet.IsEgg && pet.SkillCount == 0) pet.RelearnFromLevel();
        return pet;
    }

    // 게스트 칸과 계정 칸을 오갑니다. 지금 세이브는 지금 칸에 남깁니다.
    private async Task SwitchSaveAsync(string? slot, string? json)
    {
        if (_pet!.NeedsSave)
        {
            _pet.NeedsSave = false;
            await Store.SaveAsync(_pet);
        }

        Store.Slot = slot;
        PokemonState pet;
        if (json is null)
        {
            pet = await Store.LoadAsync();
        }
        else
        {
            await Store.ReplaceAsync(json);
            pet = SaveStore.Parse(json) ?? new PokemonState();
        }

        _pet = PreparePet(pet);
        CloseSidePanels();
        if (slot is null) _isGuest = false;
        _lastRendered = null;
        await InvokeAsync(StateHasChanged);
    }

    // 다른 탭에서 게임을 열었습니다. 이 탭은 멈춰서 세이브를 덮어쓰지 않습니다.
    [JSInvokable]
    public void OnOtherTabOpened()
    {
        _cts.Cancel();
        CloudSave.Suspend();
        _isOtherTabActive = true;
        StateHasChanged();
    }

    private void ReloadThisTab() => Navigation.NavigateTo(Navigation.Uri, forceLoad: true);

    private void ShowLoadNotice(PokemonState pet)
    {
        string? key = Store.TakeLoadNotice() ?? pet.PendingNoticeKey;
        if (key is null) return;
        pet.ShowEvent(Loc.T(key), 10000);
        pet.PendingNoticeKey = null;
        pet.NeedsSave = true;
    }

    private void Act(Action<PokemonState> action) => action(_pet!);

    private void ToggleSleep()
    {
        _pet!.IsFeedMenuOpen = false;
        _pet.IsPlayMenuOpen = false;
        _pet.ToggleSleep();
    }

    private void Bath()
    {
        _pet!.IsFeedMenuOpen = false;
        _pet.IsPlayMenuOpen = false;
        _pet.Clean();
    }

    private void Tap() => _pet!.Tap();

    private void ToggleFeedMenu()
    {
        PlaySound(SoundEffects.Tap);
        _pet!.IsPlayMenuOpen = false;
        _pet.IsFeedMenuOpen = !_pet.IsFeedMenuOpen;
    }

    private void TogglePlayMenu()
    {
        PlaySound(SoundEffects.Tap);
        _pet!.IsFeedMenuOpen = false;
        _pet.IsPlayMenuOpen = !_pet.IsPlayMenuOpen;
    }

    private void StartAsGuest()
    {
        _isGuest = true;
        PlaySound(SoundEffects.Play);
    }

    private void PlaySound(int[][] notes)
    {
        if (!_pet!.IsMuted) Sound.Play(notes);
    }

    private void OpenDex()
    {
        PlaySound(SoundEffects.Tap);
        _pet!.IsFeedMenuOpen = false;
        _pet.IsPlayMenuOpen = false;
        CloseSidePanels();
        _isDexOpen = true;
    }

    private void OpenProfile()
    {
        PlaySound(SoundEffects.Tap);
        _pet!.IsFeedMenuOpen = false;
        _pet.IsPlayMenuOpen = false;
        CloseSidePanels();
        _pet.IsProfileOpen = true;
    }

    private void OpenParty()
    {
        PlaySound(SoundEffects.Tap);
        CloseSidePanels();
        _isPartyOpen = true;
    }

    private void OpenBag()
    {
        PlaySound(SoundEffects.Tap);
        CloseSidePanels();
        _isBagOpen = true;
    }

    private void CloseSidePanels()
    {
        _pet!.IsFeedMenuOpen = false;
        _pet.IsPlayMenuOpen = false;
        _pet.IsProfileOpen = false;
        _isDexOpen = false;
        _isPartyOpen = false;
        _isBagOpen = false;
        _isGymOpen = false;
        _isArenaOpen = false;
        _isSettingsOpen = false;
    }

    private void OpenGym()
    {
        PlaySound(SoundEffects.Tap);
        CloseSidePanels();
        _isGymOpen = true;
    }

    private void OpenArena()
    {
        PlaySound(SoundEffects.Tap);
        CloseSidePanels();
        _isArenaOpen = true;
    }

    private void StartArena((ArenaEntry Foe, ArenaEntry Me) match)
    {
        PlaySound(SoundEffects.Play);
        CloseSidePanels();
        _pet!.StartArenaBattle(match.Foe, match.Me);
    }

    // 로컬 테스트 상대(uid가 test)와 한 대전은 저장하지 않습니다.
    private async Task SaveArenaResultAsync(ArenaEntry entry)
    {
        if (entry.Uid is null or "me") return;
        if (!await Arena.SaveAsync(entry)) _pet?.ShowEvent(Loc.T("web.arena.saveFailed"), 8000);
    }

    private void OpenSettings()
    {
        PlaySound(SoundEffects.Tap);
        CloseSidePanels();
        _isSettingsOpen = true;
    }

    private void StartWalk()
    {
        PlaySound(SoundEffects.Play);
        CloseSidePanels();
        _pet!.BeginWalk();
    }

    private void StartGym(int index)
    {
        PlaySound(SoundEffects.Play);
        CloseSidePanels();
        _pet!.StartGymBattle(index);
    }

    private void StartBattle()
    {
        PlaySound(SoundEffects.Play);
        CloseSidePanels();
        _pet!.StartWildBattle();
    }

    private string Summary(PokemonState pet) =>
        pet.IsEgg ? Loc.T("pokemon.egg") : $"{Dex.GetName(pet.SpeciesId, Loc.Language)} Lv.{pet.Level}";

    private string CloudStatusText => CloudSave.SignInError is not null
        ? Loc.T("web.cloud.signInFailed")
        : CloudSave.Status switch
        {
            CloudStatus.Unavailable => Loc.T("web.cloud.unavailable"),
            CloudStatus.Syncing => Loc.T("web.cloud.syncing"),
            CloudStatus.Saved => Loc.T("web.cloud.saved"),
            CloudStatus.Failed => Loc.T("web.cloud.failed"),
            _ => "",
        };

    private async Task ReloadWithSaveAsync(string json)
    {
        _cts.Cancel(); // 다시 불러오기 전에 지금 세이브가 새 세이브를 덮어쓰지 않게 멈춥니다.
        CloudSave.Suspend();
        await Store.ReplaceAsync(json);
        Navigation.NavigateTo(Navigation.Uri, forceLoad: true);
    }

    private void CloseProfile() => _pet!.IsProfileOpen = false;

    private void ToggleMute()
    {
        _pet!.IsMuted = !_pet.IsMuted;
        _pet.NeedsSave = true;
        PlaySound(SoundEffects.Tap);
    }

    private Task ToggleLanguageAsync() => Loc.ToggleLanguageAsync();

    private async Task RunLoopAsync()
    {
        using var timer = new PeriodicTimer(TimeSpan.FromMilliseconds(33));
        long last = Stopwatch.GetTimestamp();
        try
        {
            while (await timer.WaitForNextTickAsync(_cts.Token))
            {
                long now = Stopwatch.GetTimestamp();
                double elapsedMs = Stopwatch.GetElapsedTime(last, now).TotalMilliseconds;
                last = now;
                if (elapsedMs > MAX_CATCH_UP_MS || ShowTitle || CloudSave.IsWaitingForChoice) continue;

                _pet!.IsPanelOpen = _isDexOpen || _isPartyOpen || _isBagOpen || _isGymOpen || _isArenaOpen || _isSettingsOpen;
                _pet.Update(elapsedMs);
                CloudSave.Tick(elapsedMs);

                if (_pet.NeedsSave)
                {
                    _pet.NeedsSave = false;
                    await Store.SaveAsync(_pet);
                }

                // 값이 바뀌었을 때만 다시 그립니다.
                object rendered = (_pet.PosX, _pet.FlipX, _pet.CurrentAction, _pet.MoodKey, _pet.IsPetting, _pet.IsNight,
                    (_pet.Fullness, _pet.Joy, _pet.Energy, _pet.Hygiene, _pet.Poops, _pet.Level, _pet.SpeciesId),
                    (_pet.IsEvolvingFlash, _pet.HasEvolved, _pet.CanShowEvolvePrompt, _pet.CanShowFarewellPrompt, _pet.IsSleeping),
                    (_pet.EatingFood, _pet.IsBathing, _pet.ShownGame, _pet.FoodBites, Math.Round(_pet.FoodOpacity, 1), _pet.IsSwapMode, _pet.EventMessage));
                if (_pet.ShownGame != MiniGame.None || _pet.IsBattleOpen || _pet.IsWalking || !rendered.Equals(_lastRendered))
                {
                    _lastRendered = rendered;
                    StateHasChanged();
                }
            }
        }
        catch (OperationCanceledException) { }
    }

    private void OnCloudChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        CloudSave.Changed -= OnCloudChanged;
        _cts.Cancel();
        _cts.Dispose();
        _pageRef?.Dispose();
    }
}
